                 f"{body} · {title}", "-t", "10000",
                 "--exec", "xdg-open", "--", out_dir],
                check=False, timeout=15)
        except Exception:
            pass
        return
    try:
        subprocess.run(
            ["notify-send", "-a", "Video Downloader Ultra", "-t", "10000",
             "Playlist downloaded", f"{body}\n{out_dir}"],
            check=False, timeout=15)
    except Exception:
