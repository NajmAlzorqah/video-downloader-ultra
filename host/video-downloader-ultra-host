def resolve_file(candidate, out_dir):
    if not isinstance(candidate, str) or not candidate:
        return None
    if RE_CTRL.search(candidate):
        return None
    p = pathlib.Path(candidate)
    if not p.is_file():
        return None
    try:
        real = os.path.realpath(candidate)
    except OSError:
        return None
    base = os.path.realpath(out_dir)
    head = base if base.endswith(os.sep) else base + os.sep
    if not real.startswith(head):
        return None
    return real


def split_sections(main_file):
    """Section files produced by --split-chapters next to the (kept) original.

    yt-dlp >=2025 keeps the whole video and reports only the original path via
    the after_move NJDP:FILE print, so the section files are derived from the
    main filename (same dir + stem, then " - NN_title<ext>"). Returns [] when
    nothing matched, so callers keep the original file as a safe fallback.
    """
    if not isinstance(main_file, str) or not main_file:
        return []
    d = os.path.dirname(main_file)
    stem, ext = os.path.splitext(os.path.basename(main_file))
    re_section = re.compile(
        re.escape(stem) + r" - [0-9]{2,}_.*" + re.escape(ext) + r"\Z")
    out = []
    for cand in sorted(glob.glob(os.path.join(d, stem + " - [0-9][0-9]*_*" + ext))):
        if cand == main_file:
            continue
        if RE_CTRL.search(cand) or not re_section.match(os.path.basename(cand)):
            continue
        if os.path.isfile(cand):
            out.append(cand)
    return out


def is_playlist_url(url):
    """True for URLs yt-dlp treats as playlists by shape: YouTube playlists
    carry `list=<id>` in the query, Bilibili uses a `/playlist` path. The
    download/probe/section logic all share this one shape test (a URL with a
    playlist param but `--no-playlist` still reports playlist fields, so probe
    and build_command agree on what counts as a playlist).
    """
    u = (url or "").lower()
    return "list=" in u or "/playlist" in u


def build_command(url, sel, with_subs=True, temp_dir=None):
    out_dir = sel.get("outputDir")
    if not isinstance(out_dir, str) or not out_dir.replace("/", "").strip():
        out_dir = DEFAULT_DIR
    out_dir = os.path.expanduser(out_dir)
    os.makedirs(out_dir, exist_ok=True)

    playlist = sel.get("playlist") is True
    is_pl = playlist and is_playlist_url(url)
    audio_only = sel.get("audioOnly") is True
    audio_fmt = sel.get("audioFmt")
    if audio_fmt not in ("best", "m4a", "mp3", "opus"):
        audio_fmt = "mp3"

    format_id = sel.get("formatId")
    if not isinstance(format_id, str) or not RE_FMTID.fullmatch(format_id):
        format_id = None
    format_has_audio = format_id is not None and sel.get("formatHasAudio") is True

    cmd = [YTDLP, "--newline", "--progress", "--no-warnings"]
    cmd += ["--yes-playlist"] if is_pl else ["--no-playlist"]
    if is_pl:
        cmd += ["--ignore-errors"]

    if audio_only:
        if format_id is not None:
            # Mirror the video branch's playlist fallback: on a playlist a
            # bare format id can 404 partway through, so fall back to the
            # best-audio-flexible selector for the rest of the list.
            fsel = format_id + ("/ba/b" if is_pl else "")
        else:
            fsel = "ba/b"
        cmd += ["-f", fsel]
        cmd += ["-x", "--audio-format", audio_fmt]
        if audio_fmt != "best":
            cmd += ["--audio-quality", "0"]
        out_tpl = (
            "%(playlist_title)s/%(playlist_index)03d_%(title)s.%(ext)s"
            if is_pl else "%(title)s.%(ext)s"
        )
    else:
        container = sel.get("container")
        if container not in MERGE_CONTAINERS:
            container = "best"
        # merge_ext is implied by the format's container only when no explicit
        # --merge-output-format container was requested; at most one flag is
        # appended and an explicit container wins over the implied one.
        merge_ext = ""
        if format_id is not None:
            if format_has_audio:
                fsel = format_id
            else:
                ext = sel.get("formatExt")
                ext = ext.lower() if isinstance(ext, str) else ""
                if ext in MERGE_CONTAINERS and ext != "best":
                    fsel = f"{format_id}+ba[ext={ext}]/{format_id}+ba/b"
                    if container == "best":
                        merge_ext = ext
                else:
                    fsel = format_id + "+ba/b"
            if is_pl:
                fsel += "/bv*+ba/b"
            cmd += ["-f", fsel]
        else:
            res = sel.get("resolution")
            res = str(res).strip() if res is not None else "best"
            if res == "best" or res == "" or RE_INT.fullmatch(res) is None:
                cmd += ["-f", "bv*+ba/b"]
            else:
                h = max(1, min(int(res), 4320))
                cap = f"[height<={h}]"
                cmd += ["-f", f"bv*{cap}+ba/b{cap}"]
        if merge_ext:
            cmd += ["--merge-output-format", merge_ext]
        elif container != "best":
            cmd += ["--merge-output-format", container]
        out_tpl = (
            "%(playlist_title)s/%(playlist_index)03d_%(title)s.%(ext)s"
            if is_pl else "%(title)s.%(ext)s"
        )

    chapters = sel.get("chapters")
    if chapters not in ("embed", "split"):
        chapters = None
    if chapters and not audio_only:
        if chapters == "embed":
            cmd += ["--embed-chapters"]
        else:
            cmd += ["--split-chapters"]
            chapter_tpl = (
                ("%(playlist_title)s/%(playlist_index)03d_%(title)s - "
                 "%(section_number)02d_%(section_title)s.%(ext)s" if is_pl else
                 "%(title)s - %(section_number)02d_%(section_title)s.%(ext)s"))
            cmd += ["-o", "chapter:" + chapter_tpl]

    cmd += ["--paths", out_dir]
    if temp_dir:
        cmd += ["--paths", "temp:" + temp_dir]
    cmd += ["-o", out_tpl]

    if with_subs:
        subs = sel.get("subs") or {}
        if subs.get("on") is True:
            cmd += ["--write-subs"]
            if subs.get("auto") is True:
                cmd += ["--write-auto-subs"]
            langs = subs.get("langs")
            if isinstance(langs, str) and langs != "all" and RE_LANG.fullmatch(langs):
                cmd += ["--sub-langs", langs]
            elif subs.get("auto") is not True:
                cmd += ["--sub-langs", "all"]
            sub_fmt = subs.get("subFormat")
            if not (isinstance(sub_fmt, str) and RE_LANG.fullmatch(sub_fmt) and len(sub_fmt) <= 12):
                sub_fmt = "best/srt"
            cmd += ["--sub-format", sub_fmt]
            convert = subs.get("convert")
            if sub_fmt == "srt":
                convert = "srt"
            if convert in ("srt", "vtt"):
                cmd += ["--convert-subs", convert]
            if subs.get("embed") is True:
                cmd += ["--embed-subs", "--embed-metadata"]

    cmd += [
        "--progress-template",
        "download:NJDP:PCT\t%(progress._percent_str)s\t%(progress._speed_str)s\t%(progress._eta_str)s\t%(progress.downloaded_bytes)s\t%(progress.total_bytes|total_bytes_estimate)s",
        "--print", "after_move:NJDP:FILE\t%(filepath)s",
        "--print", "after_move:NJDP:TITLE\t%(title)j",
        "--",
        url,
    ]
    return cmd, out_dir


def osd_available():
    return not os.environ.get("VDU_NO_OMARCHY") and omarchy_tool("omarchy-shell") is not None


def _osd_report(state, issue=""):
    _osd_health["state"] = state
    _osd_health["issue"] = issue
    _osd_health["t"] = time.monotonic()


def _osd_err_text(stderr):
    # Sanitize captured stderr into a short one-line reason (ANSI/control
    # stripped, capped) — never echoed verbatim to any surface.
    try:
        s = stderr.decode("utf-8", "replace")
    except Exception:
        return ""
    s = RE_ANSI.sub("", s)
    s = RE_CTRL.sub("", s)
    return s.strip()[:120]


def _osd_show(ipc_payload):
    tool = omarchy_tool("omarchy-shell")
    if not tool or os.environ.get("VDU_NO_OMARCHY"):
        return "missing", "omarchy-shell unavailable (VDU_NO_OMARCHY or not found)"
    try:
        r = subprocess.run([tool, "-q", "najmalzorqah.video-downloader-ultra.osd", "show", ipc_payload],
                           check=False, timeout=3, stdout=subprocess.DEVNULL,
                           stderr=subprocess.PIPE)
    except Exception as e:
        return "broken", "osd show failed: %s" % (str(e)[:80] or type(e).__name__)
    if r.returncode == 0:
        return "ok", ""
    issue = _osd_err_text(r.stderr) or "osd show exited %d" % r.returncode
    return "broken", issue


def osd_health():
    """Best-effort OSD IPC health for the `ping` reply.

    State is "unknown" until something probes; probing is cheap-signal based
    (see probe_osd) so a working system never flashes an extra card.
    """
    state, issue = _osd_health["state"], _osd_health["issue"]
    if os.environ.get("VDU_NO_OMARCHY"):
        return "missing", "disabled (VDU_NO_OMARCHY)"
    return state, issue


def probe_osd():
    """Re-check OSD IPC health, TTL-gated. Only called right before a real OSD
    card is about to appear (download start) or from show/close failures, so the
    probe's own show+close (duration 0) adds no visible flash at rest."""
    now = time.monotonic()
    state, issue = _osd_health["state"], _osd_health["issue"]
    if state != "unknown" and now - _osd_health["t"] < OSD_PROBE_TTL_S:
        return state, issue
    if not osd_available():
        _osd_report("missing", "omarchy-shell unavailable (VDU_NO_OMARCHY or not found)")
        return "missing", _osd_health["issue"]
    state, issue = _osd_show(OSD_PROBE_PAYLOAD)
    _osd_report(state, issue)
    if state == "ok":
        osd_close()
    return state, issue


def osd_progress(pct_int, title=None):
    tool = omarchy_tool("omarchy-shell")
    if not tool or os.environ.get("VDU_NO_OMARCHY"):
        return
    payload = json.dumps({
        "icon": OSD_ICON_DOWNLOAD,
        "message": title or "",
        "value": str(pct_int),
        "progressText": "%d%%" % pct_int,
        "max": "100",
        "duration": "8000",
        "ipc": OSD_IPC_TAG,
        "iface_version": OSD_IPC_VERSION,
    })
    args = [tool, "-q", "najmalzorqah.video-downloader-ultra.osd", "show", payload]
    try:
        r = subprocess.run(args, check=False, timeout=3, stdout=subprocess.DEVNULL,
                           stderr=subprocess.PIPE)
    except Exception as e:
        _osd_report("broken", "osd show failed: %s" % (str(e)[:80] or type(e).__name__))
        return
    if r.returncode == 0:
        _osd_report("ok")
    else:
        _osd_report("broken", _osd_err_text(r.stderr) or "osd show exited %d" % r.returncode)


def osd_close():
    tool = omarchy_tool("omarchy-shell")
    if not tool or os.environ.get("VDU_NO_OMARCHY"):
        return
    try:
        r = subprocess.run([tool, "-q", "najmalzorqah.video-downloader-ultra.osd", "close"],
                           check=False, timeout=3, stdout=subprocess.DEVNULL,
                           stderr=subprocess.PIPE)
    except Exception as e:
        _osd_report("broken", "osd close failed: %s" % (str(e)[:80] or type(e).__name__))
        return
    if r.returncode == 0:
        _osd_report("ok")
    else:
        _osd_report("broken", _osd_err_text(r.stderr) or "osd close exited %d" % r.returncode)


def notify_done(title, filepath):
    if not os.path.isfile(filepath):
        return
    image = None
    if os.path.exists(FFMPEG):
        fd, preview = tempfile.mkstemp(suffix=".jpg")
        os.close(fd)
        try:
            crop = "crop='min(iw,ih)':'min(iw,ih)',scale=256:256"
            subprocess.run(
                [FFMPEG, "-y", "-ss", "00:00:00.1", "-i", filepath,
                 "-vframes", "1", "-vf", crop, "-q:v", "2", preview, "-loglevel", "quiet"],
                check=False, timeout=30)
            if os.path.getsize(preview) == 0:
                os.unlink(preview)
                preview = None
        except Exception:
            try:
                os.unlink(preview)
            except Exception:
                pass
            preview = None
        image = preview or None

    omarchy_send = omarchy_tool("omarchy-notification-send")
    if omarchy_send and not os.environ.get("VDU_NO_OMARCHY"):
        args = [omarchy_send, "-g", OSD_ICON_DONE, "Download complete", title, "-t", "10000"]
        if image:
            args += ["--image", image]
        args += ["--exec", "mpv", "--", filepath]
        try:
            subprocess.run(args, check=False, timeout=15)
        except Exception:
            pass
    else:
        args = ["notify-send", "-a", "Video Downloader Ultra", "-t", "10000"]
        if image:
            args += ["-i", image]
        args += [title, "Download complete", "--action=play=Play with mpv"]
        try:
            subprocess.run(args, check=False, timeout=15)
        except Exception:
            pass

    if image:
        def _rm():
            try:
                if os.path.exists(image):
                    os.unlink(image)
            except OSError:
                pass
        # Give the notification daemon generous time to consume the preview:
        # the notification send above can itself block up to 15s, so deleting
        # 8s after it returns risks ripping the thumbnail out from under a slow
        # backend. 30s outlives the send regardless.
        threading.Timer(30.0, _rm).start()


def notify_many(count, first_title, out_dir):
    title = clean(first_title, 200) or "Playlist download"
    body = f"{count} files saved"
    omarchy_send = omarchy_tool("omarchy-notification-send")
