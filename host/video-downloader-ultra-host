def notify_error(message):
    if not isinstance(message, str) or not message:
        return
    msg = clean(message, 300) or "Download failed"
    omarchy_send = omarchy_tool("omarchy-notification-send")
    if omarchy_send and not os.environ.get("VDU_NO_OMARCHY"):
        try:
            subprocess.run(
                [omarchy_send, "-u", "critical", "-g", OSD_ICON_FAIL, "Download failed", msg],
                check=False, timeout=15)
        except Exception:
            pass
        return
    try:
        subprocess.run(["notify-send", "-a", "Video Downloader Ultra", "-u", "critical",
                        "Download failed", msg], check=False, timeout=15)
    except Exception:
        pass


def download_worker(job):
    """Run the job on its own thread, always advancing the queue.

    `_download_worker` performs the whole download; this wrapper guarantees the
    queue is never left wedged and the popup always gets a terminal event, even
    when an unexpected exception escapes the big body (the `send()` OSError
    guard already covers the dying-stdout case, this is the belt-and-suspenders
    net). `finish_job(job)` is idempotent per job, so a worker that already
    called it on its happy/cancel/error paths won't double-promote.

    Every job gets a per-job scratch dir (`job["_tmpdir"]`) that yt-dlp's
    `--paths temp:` rents for its intermediary files (.part/.ytdl/per-stream
    copies) — they never land in the user's output dir. The dir is removed
    here on every terminal path (done/error/cancel/unexpected exception) so a
    cancelled download never leaves partial files behind.
    """
    job["_tmpdir"] = tempfile.mkdtemp(prefix="vdu-dl-")
    try:
        _download_worker(job)
    except Exception:
        if not job.get("_ended"):
            try:
                send({"req": job.get("req"), "event": "error",
                      "message": "Internal error — please retry"})
            except Exception:
                pass
    finally:
        finish_job(job)
        forget_req(job.get("req"))
        shutil.rmtree(job["_tmpdir"], ignore_errors=True)
        inflight_dec()


def _download_worker(job):
    global current_proc
    req = job["req"]
    url = http_url(job.get("url"))
    if url is None:
        job["_ended"] = True
        send({"req": req, "event": "error", "message": "Unsupported URL"})
        finish_job()
        return
    sel = job["selection"]

    send({"req": req, "event": "start"})
    items = []
    title = clean(sel.get("title"), 200) if isinstance(sel.get("title"), str) else None
    osd_pct = [0]
    osd_keepalive_ms = [0.0]

    def _osd_refresh(pct):
        # Keep the bottom-center download OSD (title over a progress bar)
        # alive — it hides after its own duration. Progress ticks call this
        # ~1/s; the subtitle lock probe's retry gaps call it with None to
        # re-show the last percent, so the bar doesn't expire mid-probe.
        #
        # One refresh gate (2.5s): every osd_progress() spawns an
        # `omarchy-shell` subprocess (~46ms), and an earlier separate 0.25s
        # pct-change block doubled that to a shell spawn per second for the
        # whole download. 2.5s stays well inside the 8s card life while
        # cutting shell-PID churn ~2-4x; pct updates inline, so the card
        # always re-shows the latest value.
        now = time.monotonic()
        if now - osd_keepalive_ms[0] < 2.5:
            return
        osd_keepalive_ms[0] = now
        if pct is not None:
            osd_pct[0] = max(0, min(100, int(pct)))
        osd_progress(osd_pct[0], title)

    if osd_available():
        # Probe IPC health before the card appears; osd_progress below also
        # feeds health back opportunistically (a success marks it ok, a failure
        # records why) without any extra show/close at rest.
        probe_osd()
        osd_progress(0, title)
        # The card was just shown at 0%; arm the refresh gate so the first
        # progress tick is accepted right away instead of waiting out a full
        # 2.5s window against a fresh (0.0) keepalive.
        osd_keepalive_ms[0] = time.monotonic()

    is_pl = sel.get("playlist") is True and is_playlist_url(url)

    SUB_RATELIMITED = ("Subtitles didn't download — the site is rate-limiting subtitle "
                       "requests (HTTP 429). Try again in a few minutes.")
    SUB_FAILED = ("Subtitles didn't download — the site didn't serve them. "
                  "The video was saved without subtitles.")

    lock_log = []

    def _ratelimited(*texts):
        return any(RE_RATELIMIT.search(t) for t in texts if t)

    def _cancel_pending():
        with STATE_LOCK:
            return cancel_flag

    def _sleep_until(delay):
        # Slice the backoff so a cancel lands in milliseconds, not seconds.
        # A probe's retry gap is quiet for the OSD — refresh it here so it
        # doesn't expire mid-lock-probe (worst case SUB_LOCK_TIMEOUT x 3).
        end = time.monotonic() + delay
        while True:
            if _cancel_pending():
                return False
            remaining = end - time.monotonic()
            if remaining <= 0:
                return True
            _osd_refresh(None)
            time.sleep(min(remaining, 0.1))

    def subtitle_lock_ok():
        # "ok" subs served fine · "cancelled" user stopped mid-probe ·
        # "unknown" inconclusive (timeout or a non-subtitle failure — proceed
        # and let the real run decide) · "blocked" subtitle-specific failure,
        # give up and skip subs. Runs in a scratch dir so a cancelled/blocked
        # probe never leaves subtitle files in the real output dir, and is
        # terminated promptly by cancel.
        global lock_proc
        lock_sel = dict(sel)
        tmp_dir = tempfile.mkdtemp(prefix="vdu-sublock-")
        lock_sel["outputDir"] = tmp_dir
        # Each attempt can block up to SUB_LOCK_TIMEOUT in communicate(); the
        # backoff _sleep_until() refreshes the OSD only between attempts, so
        # a per-attempt clock thread keeps the download OSD alive through
        # the long silence too.
        def _osd_clock(stopping):
            while not stopping.wait(1.0):
                _osd_refresh(None)
        try:
            cmd, _ = build_command(url, lock_sel, with_subs=True, temp_dir=tmp_dir)
            if "--" in cmd:
                cmd.insert(cmd.index("--"), "--skip-download")
            if is_pl and "--" in cmd:
                i = cmd.index("--")
                cmd[i:i] = ["--playlist-items", "1"]
            for attempt in range(3):
                if _cancel_pending():
                    return "cancelled"
                proc = subprocess.Popen(
                    cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
                    text=True)
                with STATE_LOCK:
                    lock_proc = proc
                # A cancel that landed between the caller's _cancel_pending()
                # check (above) and this Popen wasn't seen by the cancel
                # handler's terminate step (lock_proc wasn't published yet);
                # kill it here so communicate() returns promptly and the loop
                # reports "cancelled" instead of blocking up to SUB_LOCK_TIMEOUT.
                if _cancel_pending():
                    proc.terminate()
                stopping = threading.Event()
                clock = threading.Thread(target=_osd_clock, args=(stopping,), daemon=True)
                clock.start()
                try:
                    try:
                        _out, err = proc.communicate(timeout=SUB_LOCK_TIMEOUT)
                    except subprocess.TimeoutExpired:
                        with STATE_LOCK:
                            if lock_proc is proc:
                                lock_proc = None
                        proc.kill()
                        try:
                            proc.communicate(timeout=5)
                        except (subprocess.TimeoutExpired, OSError):
                            pass
                        return "unknown"
                finally:
                    stopping.set()
                    clock.join(timeout=2)
                    with STATE_LOCK:
                        if lock_proc is proc:
                            lock_proc = None
                if _cancel_pending():
                    return "cancelled"
                if proc.returncode == 0:
                    return "ok"
                lock_log.append(err)
                if not any(RE_SUB_ERROR.search(l) for l in (err or "").splitlines()):
                    return "unknown"
                if attempt < 2 and not _sleep_until(2 * (attempt + 1)):
                    return "cancelled"
            return "blocked"
        finally:
            shutil.rmtree(tmp_dir, ignore_errors=True)

    def run_one(with_subs):
        global current_proc
        cmd, out_dir = build_command(url, sel, with_subs=with_subs,
                                     temp_dir=job["_tmpdir"])
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE,
                                stderr=subprocess.STDOUT, text=True, bufsize=1)
        with STATE_LOCK:
            current_proc = proc
        # A cancel that landed between the caller's `_cancel_pending()` check
        # and this Popen (the worker hadn't published `current_proc` yet) would
        # otherwise be missed and the whole download would run to the end just
        # to self-report as cancelled; kill it now so the caller's `rc < 0`
        # path handles it promptly.
        if _cancel_pending():
            proc.terminate()
        # A pause can land while no proc is spawned yet — most notably during
        # the subtitle lock probe, which runs before this first run_one() while
        # only lock_proc is set, and again in the retry gap (the caller
        # re-invokes run_one below). The pause handler SIGSTOPs current_proc
        # only, so a stop issued against a None proc just sets the flag and is
        # now applied here: a paused child stops immediately instead of running
        # at full speed under a "paused" headline. The cancel check above takes
        # precedence — a cancelled job is killed, never stopped (terminating a
        # SIGSTOP'd process would wedge the worker on a never-closing pipe).
        with STATE_LOCK:
            should_stop = active_job.get("paused") and not cancel_flag
        if should_stop and proc.poll() is None:
            try:
                proc.send_signal(signal.SIGSTOP)
            except Exception:
                pass
        errors = []
        last_ev = [0.0]
        titles = {}
        last_file = [None]
        for raw in proc.stdout:
            line = RE_ANSI.sub("", raw.rstrip("\r\n")).strip()
            if not line:
                continue
            if line.startswith("ERROR:"):
                errors.append(line[6:].strip()[:500])
                continue
            if line.startswith("NJDP:PCT\t"):
                parts = line.split("\t")
                try:
                    pct = float(parts[1].replace("%", "").strip())
                except (IndexError, ValueError):
                    continue
                speed = clean(parts[2]) if len(parts) > 2 else None
                eta = clean(parts[3]) if len(parts) > 3 else None
                def _n(i):
                    try:
                        v = int(float(parts[i].strip().replace(",", "")))
                        return v if v > 0 else None
                    except (IndexError, ValueError):
                        return None
                downloaded = _n(4)
                total = _n(5)
                now = time.monotonic()
                if now - last_ev[0] >= 0.25:
                    last_ev[0] = now
                    send({"req": req, "event": "progress",
                          "pct": round(pct, 1), "speed": speed, "eta": eta,
                          "downloaded": downloaded, "total": total})
                    # Coarse mirror progress, broadcast req-less so popup and
                    # widget both see any job's progress without owning its
                    # req stream. `queueId` lets readers attach it to a row.
                    send({"event": "progress", "queueId": job["id"],
                          "pct": round(pct, 1), "speed": speed, "eta": eta,
                          "downloaded": downloaded, "total": total})
                _osd_refresh(int(pct))
                continue
            if line.startswith("NJDP:FILE\t"):
                real = resolve_file(line.split("\t", 1)[1], out_dir)
                if real and real not in items:
                    items.append(real)
                    last_file[0] = real
                    if not sel.get("playlist"):
                        send({"req": req, "event": "file", "filepath": real})
                continue
            if line.startswith("NJDP:TITLE\t"):
                raw = line.split("\t", 1)[1].strip()
                try:
                    raw = json.loads(raw)
                except (ValueError, TypeError):
                    pass
                t = clean(raw, 200) if isinstance(raw, str) else None
                if t and last_file[0]:
                    titles[last_file[0]] = t
                    last_file[0] = None
                continue
        proc.wait()
        return proc.returncode, out_dir, errors, titles

    warn_subs = None
    subs_on = bool((sel.get("subs") or {}).get("on"))

    def _cancelled_exit():
        job["_ended"] = True
        osd_close()
        send({"req": req, "event": "cancelled", "items": items})
        finish_job()

    if subs_on:
        lock = subtitle_lock_ok()
        if lock == "cancelled":
            _cancelled_exit()
            return
        if lock == "blocked":
            warn_subs = SUB_RATELIMITED if _ratelimited("\n".join(lock_log)) else SUB_FAILED
            send({"req": req, "event": "info", "message": warn_subs})

    # A cancel can land right between start_next() promoting this job and the
    # worker spawning yt-dlp; bail before launching anything, or the download
    # would run to the end and only then report itself cancelled.
    if _cancel_pending():
        _cancelled_exit()
        return
    rc, out_dir, errors, titles = run_one(warn_subs is None and subs_on)
    if rc > 0 and not items and any(RE_SUB_ERROR.search(e) for e in errors):
        if _cancel_pending():
            _cancelled_exit()
            return
        send({"req": req, "event": "info",
              "message": "Subtitle fetch failed — retrying video without subtitles"})
        warn_subs = warn_subs or (SUB_RATELIMITED if _ratelimited("\n".join(errors)) else SUB_FAILED)
        rc, out_dir, errors, titles = run_one(False)

    with STATE_LOCK:
        current_proc = None
    # A negative rc means yt-dlp was killed by a signal; the only source is
    # our own cancel handler. The flag check also covers a cancel that landed
    # just after run_one returned cleanly.
    if cancel_flag or (isinstance(rc, int) and rc < 0):
        _cancelled_exit()
        return
    if rc != 0 and not items:
        msg = errors[0] if errors else "yt-dlp failed"
        msg = clean(msg, 400) or "yt-dlp failed"
        job["_ended"] = True
        osd_close()
        send({"req": req, "event": "error", "message": msg})
        # Advance the queue before notifying: notify_error can block up to 15s
        # and the next job must start regardless of a hung notification server.
        finish_job()
        notify_error(msg)
        return
    if sel.get("chapters") == "split" and items:
        # yt-dlp keeps every whole video next to its section files; drop each
        # redundant original and report the sections as the download result.
        split_items = []
        for whole in items:
            sections = split_sections(whole)
            if not sections:
                continue
            try:
                os.remove(whole)
            except OSError:
                pass
            title = titles.get(whole)
            if title:
                for p in sections:
                    titles[p] = title
            split_items.extend(sections)
        if split_items:
            items = split_items
    osd_close()
    job["_ended"] = True
    send(dict({"req": req, "event": "done", "items": items}, **(warn_subs and {"warn": warn_subs} or {})))
    # Advance the queue before notifying: notify_done can block up to the
    # ffmpeg-thumbnail (30s) + omarchy-send (15s) timeouts and must not stall
    # the next queued job.
    finish_job()
    if len(items) > 1:
        notify_many(len(items), titles.get(items[0]) or "", out_dir)
    else:
        for p in items:
            notify_done(titles.get(p) or os.path.basename(p), p)


# ------------------------------------------------------------------- main ---

def cleanup_agent():
    try:
        os.unlink(AGENT_SOCK_PATH)
    except OSError:
        pass
    try:
        os.unlink(AGENT_PID_PATH)
    except OSError:
        pass


def bind_agent_socket():
    """Create/lock the agent unix socket. Returns the listening socket, or
    None when another agent is already serving (callers exit quietly).

    Single-instance is the flock on `agent.lock`: a crashed agent releases it
    but can leave a stale socket file, so after winning the lock we unlink any
    leftover file (no other bound socket can exist — we hold the lock) and
    bind fresh. The socket and its directory are user-only (0600/0700): the
    peer is same-user local IPC, not a trust boundary — requests are still
    sanitized exactly like the stdio host's.
    """
    os.makedirs(AGENT_SOCK_DIR, mode=0o700, exist_ok=True)
    lock_path = os.path.join(AGENT_SOCK_DIR, "agent.lock")
    lock_fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(lock_fd)
        return None
    try:
        os.unlink(AGENT_SOCK_PATH)
    except OSError:
        pass
    try:
        os.unlink(AGENT_PID_PATH)
    except OSError:
        pass
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.bind(AGENT_SOCK_PATH)
    os.chmod(AGENT_SOCK_PATH, 0o600)
    sock.listen(AGENT_MAX_CLIENTS)
    sock.setblocking(True)
    try:
        with open(AGENT_PID_PATH, "w") as f:
            f.write("%d\n" % os.getpid())
        os.chmod(AGENT_PID_PATH, 0o600)
    except OSError:
        pass
    return sock


def agent_connect():
    """Connect to a running agent, spawning one if the socket is missing."""
    def try_connect():
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.connect(AGENT_SOCK_PATH)
            return s
        except OSError:
            s.close()
            return None

    s = try_connect()
    if s is not None:
        return s
    # Lazy-spawn the daemon. stdout MUST be /dev/null: this host's stdout is
    # the browser's native-messaging pipe, and if the agent inherited it the
    # pipe would stay open after the shim exits, hiding the disconnect.
    try:
        subprocess.Popen(
            [sys.executable, os.path.realpath(sys.argv[0]), "--agent"],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, start_new_session=True,
            close_fds=True)
    except OSError:
        return None
    deadline = time.monotonic() + AGENT_SPAWN_WAIT_S
    while time.monotonic() < deadline:
        time.sleep(0.05)
        s = try_connect()
        if s is not None:
            return s
    return None


# In-flight worker accounting: a probe or download thread is running. The
# agent only idle-exits when nothing is in flight (a download keeps its job
# in active_job, but a lone probe has no queue entry to check).
INFLIGHT_LOCK = threading.Lock()
inflight = 0


def inflight_inc():
    global inflight
    with INFLIGHT_LOCK:
        inflight += 1


def inflight_dec():
    global inflight
    with INFLIGHT_LOCK:
        inflight = max(0, inflight - 1)


SOCK_CLOSE_MARK = ("__close__",)


def client_reader(client, requests):
    """Read JSON-lines from one socket client and queue them for dispatch.

    Each frame's `req` is rewritten to the internal "nd<uid>:<raw>" key and
    registered with its owner, so the serialized handler (and the job/probe
    worker threads that share it) route replies back to the right peer even
    though every popup/widget starts its own req sequence at 1.

    On peer EOF the client is NOT closed here: the socket must stay writable
    until the dispatcher has sent the replies promised for the frames already
    queued. Instead a SOCK_CLOSE_MARK is queued *after* those frames; the
    dispatcher closes the client only once it has drained past them (FIFO
    guarantees the mark follows every frame this reader enqueued).
    """
    buf = b""
    try:
        while True:
            data = client.sock.recv(65536)
            if not data:
                break
            buf += data
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                line = line.strip()
                if not line or len(line) > MAX_FRAME:
                    continue
                try:
                    obj = json.loads(line.decode("utf-8"))
                except (ValueError, UnicodeDecodeError):
                    continue
                if not isinstance(obj, dict):
                    continue
                raw_req = obj.get("req")
                if raw_req is not None:
                    mangled = "%s%d:%s" % (AGENT_PREFIX, client.uid, raw_req)
                    with CLIENT_LOCK:
                        REQ_OWNERS[mangled] = (client, raw_req)
                    obj = dict(obj)
                    obj["req"] = mangled
                requests.put(obj)
    except OSError:
        pass
    finally:
        requests.put(SOCK_CLOSE_MARK + (client.uid,))


def handle_request(frame):
    """Serialized dispatch of one request frame (shared by all clients)."""
    global current_proc, cancel_flag, lock_proc, active_job, next_job_id
    req = frame.get("req")
    action = frame.get("action")

    if action == "cancel":
        target = frame.get("queueId")
        if isinstance(target, int):
            # A queueId-cancel targets a *waiting* item only. An id that
            # isn't among the waiters anymore (it was just promoted to
            # active, or already removed) is a no-op — never cancel the
            # running job because of a stale Remove click.
            removed = None
            with STATE_LOCK:
                for i, j in enumerate(wait_queue):
                    if j["id"] == target:
                        removed = j
                        wait_queue.pop(i)
                        break
            if removed is not None:
                # This job's per-originator stream is gone with it (it was
                # waiting — nothing was ever spawned for it), so its owner
                # entry is dead weight until this client disconnects; scrub it.
                forget_req(removed["req"])
                send({"req": req, "ok": True})
                send_queue()
            else:
                send({"req": req, "ok": False, "error": "not found"})
            forget_req(req)
            return
        # No queueId: cancel the active job.
        with STATE_LOCK:
            proc = current_proc
            lproc = lock_proc
            was_paused = active_job is not None and active_job.get("paused") is True
            if active_job is not None:
                cancel_flag = True
        if proc is not None and was_paused:
            # A SIGSTOP'd child doesn't process SIGTERM (and never writes to or
            # closes its stdout), which would wedge the worker's read loop on a
            # never-closing pipe. Continue it first so the terminate below
            # lands and teardown is prompt.
            try:
                os.kill(proc.pid, signal.SIGCONT)
            except Exception:
                pass
        if proc is not None:
            try:
                proc.terminate()
            except Exception:
                pass
        if lproc is not None:
            try:
                lproc.terminate()
            except Exception:
                pass
        send({"req": req, "ok": True})
        forget_req(req)
        return

    if action == "pause":
        paused = frame.get("paused") is True
        with STATE_LOCK:
            if active_job is None:
                send({"req": req, "ok": False, "error": "no active download"})
                forget_req(req)
                return
            already = active_job.get("paused") is True
            if paused and not already:
                active_job["paused"] = True
            elif not paused and already:
                active_job["paused"] = False
            proc = current_proc
        if proc is not None and paused != already:
            try:
                # Pause at the OS level: yt-dlp has no native pause, so
                # SIGSTOP/SIGCONT stop/resume the running subprocess. Only
                # issued on an actual state change — a second SIGSTOP on an
                # already-stopped process would need a second SIGCONT to undo.
                proc.send_signal(signal.SIGSTOP if paused else signal.SIGCONT)
            except Exception:
                pass
        send({"req": req, "ok": True})
        send_queue()
        forget_req(req)
        return

    if action == "ping":
        osd, osd_issue = osd_health()
        send({"req": req, "ok": True, "host": HOST_NAME,
              "ytdlp": os.path.exists(YTDLP), "ffmpeg": os.path.exists(FFMPEG),
              "osd": osd, "osdIssue": osd_issue,
              "deps": {
                  "ytdlp": os.path.exists(YTDLP),
                  "ffmpeg": os.path.exists(FFMPEG),
                  "omarchyShell": omarchy_tool("omarchy-shell") is not None,
                  "hyprctl": shutil.which("hyprctl") is not None,
                  "fcMatch": shutil.which("fc-match") is not None,
              }})
        forget_req(req)
        return

    if action == "probe":
        url = http_url(frame.get("url"))
        if url is None:
            send({"req": req, "ok": False, "error": "Unsupported URL"})
            forget_req(req)
            return
        inflight_inc()
        threading.Thread(target=probe_worker, args=(req, url), daemon=True).start()
        return

    if action == "download":
        url = http_url(frame.get("url"))
        if url is None:
            send({"req": req, "event": "error", "message": "Unsupported URL"})
            forget_req(req)
            return
        sel = sanitize_selection(frame.get("selection"))
        with STATE_LOCK:
            jid = next_job_id
            next_job_id += 1
            job = {"id": jid, "req": req, "url": url, "selection": sel}
            if active_job is None:
                active_job = job
                cancel_flag = False
                start_worker(job)
            else:
                wait_queue.append(job)
        send({"req": req, "ok": True, "queueId": jid})
        send_queue()
        return

    if action == "getQueue":
        send({"req": req, "ok": True, "queue": queue_snapshot()})
        forget_req(req)
        return

    if action == "reorder":
        target = frame.get("queueId")
        new_idx = frame.get("newIndex")
        if not (isinstance(target, int) and isinstance(new_idx, int) and new_idx >= 0):
            send({"req": req, "ok": False, "error": "invalid reorder"})
            forget_req(req)
            return
        with STATE_LOCK:
            target_idx = None
            for i, j in enumerate(wait_queue):
                if j["id"] == target:
                    target_idx = i
                    break
            if target_idx is None:
                missing = True
            else:
                missing = False
                item = wait_queue.pop(target_idx)
                wait_queue.insert(min(new_idx, len(wait_queue)), item)
        if missing:
            send({"req": req, "ok": False, "error": "not found"})
        else:
            send({"req": req, "ok": True})
            send_queue()
        forget_req(req)
        return

    if action == "theme":
        theme = read_theme()
        if theme is None:
            send({"req": req, "ok": False, "error": "no theme available"})
        else:
            send({"req": req, "ok": True, "theme": theme})
        forget_req(req)
        return

    send({"req": req, "ok": False, "error": "unknown action"})
    forget_req(req)


def agent_main():
    sock = bind_agent_socket()
    if sock is None:
        return

    def handle_sigterm(signum, frame):
        with STATE_LOCK:
            proc = current_proc
            lproc = lock_proc
        if proc is not None:
            try:
                os.kill(proc.pid, signal.SIGCONT)
            except OSError:
                pass
            try:
                proc.terminate()
            except OSError:
                pass
        if lproc is not None:
            try:
                os.kill(lproc.pid, signal.SIGCONT)
            except OSError:
                pass
            try:
                lproc.terminate()
            except OSError:
                pass
        cleanup_agent()
        os._exit(0)

    try:
        signal.signal(signal.SIGTERM, handle_sigterm)
        signal.signal(signal.SIGINT, handle_sigterm)
    except ValueError:
        pass
    atexit.register(cleanup_agent)

    requests = queue.Queue()

    def accept_loop():
        while True:
            try:
                conn, _ = sock.accept()
            except OSError:
                return
            client = Client(conn)
            with CLIENT_LOCK:
                if len(CLIENTS) >= AGENT_MAX_CLIENTS:
                    client.close()
                    continue
                CLIENTS[client.uid] = client
            threading.Thread(target=client_reader,
                             args=(client, requests), daemon=True).start()

    threading.Thread(target=accept_loop, daemon=True).start()

    def watchdog():
        # Idle-exit: no clients, no queue, nothing downloading/probing for
        # AGENT_IDLE_S. The agent is spawned detached by shims; this keeps it
        # from accumulating as immortal background processes across browser
        # sessions. Note: while the Omarchy widget is running it holds a
        # connection and pings every ~15s, so n_clients ≥ 1 makes the idle
        # exit unreachable by design — it only fires once the bar/widget and
        # browsers are all gone. Do not "fix" that by ignoring pings; the
        # widget staying connected is the point.
        quiet_since = time.monotonic()
        while True:
            time.sleep(5)
            with CLIENT_LOCK:
                n_clients = len(CLIENTS)
            with STATE_LOCK:
                busy = active_job is not None or bool(wait_queue)
            with INFLIGHT_LOCK:
                working = inflight > 0
            if n_clients or busy or working:
                quiet_since = time.monotonic()
            elif time.monotonic() - quiet_since >= AGENT_IDLE_S:
                cleanup_agent()
                os._exit(0)

    threading.Thread(target=watchdog, daemon=True).start()

    while True:
        item = requests.get()
        if isinstance(item, tuple) and item and item[0] == "__close__":
            # Peer EOF'd (or errored). All frames this reader enqueued have
            # been dispatched past FIFO, so it is now safe to drop the
            # client: scrub its req owners (no reply to a vanished peer is
            # worth routing) and close the socket so send() can't spin.
            uid = item[1]
            with CLIENT_LOCK:
                client = CLIENTS.pop(uid, None)
                if client is not None:
                    for key in [k for k, (c, _) in REQ_OWNERS.items()
                                if c is client]:
                        REQ_OWNERS.pop(key, None)
            if client is not None:
                client.close()
            continue
        handle_request(item)


def shim_main():
    """Browser-facing relay: the native 4-byte-framed stdio protocol in, the
    agent's JSON-lines out (and back). This process is ephemeral per session;
    the agent owns the queue and outlives it."""
    agent = agent_connect()
    if agent is None:
        return 1
    stdin_done = [False]

    def pump_in():
        while True:
            frame = read_frame(sys.stdin.buffer)
            if frame is None:
                break
            data = json.dumps(frame, ensure_ascii=False).encode("utf-8")
            try:
                agent.sendall(data + b"\n")
            except OSError:
                break
        # Half-close: the agent's reader will see EOF, queue a SOCK_CLOSE_MARK
        # after every frame it got from us, and the dispatcher closes the
        # socket only after replying. Our recv side stays open, so pump_out
        # drains those replies before hitting the agent's EOF.
        try:
            agent.shutdown(socket.SHUT_WR)
        except OSError:
            pass
        stdin_done[0] = True

    def pump_out():
        buf = b""
        # After stdin EOF the agent is obligated to close within its reply/EOF
        # handshake; this deadline guards against a wedged agent.
        last_data = time.monotonic()
        while True:
            try:
                r, _, _ = select.select([agent], [], [], 0.5)
            except OSError:
                break
            if not r:
                if stdin_done[0] and time.monotonic() - last_data >= 3.0:
                    break
                continue
            try:
                data = agent.recv(65536)
            except OSError:
                break
            if not data:
                break
            last_data = time.monotonic()
            buf += data
            lines = buf.split(b"\n")
            buf = lines.pop()
            for line in lines:
                line = line.strip()
                if not line or len(line) > MAX_FRAME:
                    continue
                try:
                    sys.stdout.buffer.write(struct.pack("<I", len(line)))
                    sys.stdout.buffer.write(line)
                    sys.stdout.buffer.flush()
                except OSError:
                    return
        agent.setblocking(False)
        try:
            while True:
                data = agent.recv(65536)
                if not data:
                    break
                for line in data.split(b"\n"):
                    line = line.strip()
                    if not line:
                        continue
                    sys.stdout.buffer.write(struct.pack("<I", len(line)))
                    sys.stdout.buffer.write(line)
                    sys.stdout.buffer.flush()
        except OSError:
            pass
        try:
            sys.stdout.buffer.flush()
        except OSError:
            pass

    t = threading.Thread(target=pump_in, daemon=True)
    t.start()
    try:
        pump_out()
    finally:
        try:
            agent.close()
        except OSError:
            pass
        t.join(timeout=2)
    return 0


def main():
    if "--agent" in sys.argv:
        agent_main()
    else:
        sys.exit(shim_main())


if __name__ == "__main__":
    main()