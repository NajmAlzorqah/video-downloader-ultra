# Agent (daemon) mode: when started with `--agent` the host serves the shared
# download queue as a JSON-lines unix-socket server instead of one native-host
# session. The default (shim) mode is a thin relay: it translates the
# browser's 4-byte framed stdio protocol to JSON-lines on the agent socket and
# frames the agent's replies back. The agent outlives any single client (it is
# what makes the queue shared + persistent), and idle-exits when unneeded.
AGENT_PREFIX = "nd"
AGENT_SOCK_DIR = (os.environ.get("XDG_RUNTIME_DIR")
                  or os.path.expanduser("~/.local/state"))
