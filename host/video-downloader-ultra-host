# Socket-routing state (agent mode only). Each connected client is a Client;
# BROADCAST goes to all of them. REQ_OWNERS maps an internal
# "nd<uid>:<req>" key to its owning (Client, original_req) so per-job streams
# (`start`/`progress`/`file`/`done`/`error`/`cancelled`/`info`) and one-shot
# acks are routed back to the client that issued the request, while `queue`
# (and mirror) events go to everybody. A frame whose internal req has no
# registered owner anymore (terminal already delivered, or a dropped job) is
# discarded.
CLIENT_LOCK = threading.Lock()
CLIENTS = {}
REQ_OWNERS = {}
UID_COUNTER = itertools.count(1)


class Client:
    """One agent-side peer speaking JSON-lines over its unix socket."""

    __slots__ = ("sock", "uid", "lock", "closed")

    def __init__(self, sock):
        self.sock = sock
        self.uid = next(UID_COUNTER)
        self.lock = threading.Lock()
        self.closed = False

    def send(self, obj):
        if self.closed:
            return
        data = json.dumps(obj, ensure_ascii=False).encode("utf-8")
        try:
            with self.lock:
                self.sock.sendall(data + b"\n")
        except OSError:
            # The peer is gone. Mark it closed so this (or another) thread
            # can't spin on a dead socket; the reader's finally already kicked
            # it out of CLIENTS. This mirrors the old stdout OSError swallow:
            # a worker must never die mid-job because its client vanished.
            self.closed = True

    def close(self):
        self.closed = True
        try:
            self.sock.close()
        except OSError:
            pass


def forget_req(req):
    """Drop the owner of an internal req once its conversation is done."""
    with CLIENT_LOCK:
        REQ_OWNERS.pop(req, None)


def send(obj):
    """Route a frame: to its owning client when `req` is an internal
    "nd<uid>:<req>" key, drop it when that owner is gone (terminal already
    delivered), otherwise broadcast to every live client."""
    req = obj.get("req")
    if isinstance(req, str) and req.startswith(AGENT_PREFIX) and ":" in req:
        with CLIENT_LOCK:
            hit = REQ_OWNERS.get(req)
        if hit is not None:
            client, orig = hit
            out = dict(obj)
            out["req"] = orig
            client.send(out)
            return
        # Owning req forgotten (terminal event already delivered) — drop.
        return
    with CLIENT_LOCK:
        live = list(CLIENTS.values())
    for c in live:
        c.send(obj)

# Download queue coordination. At most one job downloads at a time
# (`active_job`); every further `download` request is appended to `queue` and
# promoted in FIFO order as the active job finishes (done, error, or cancel).
# `queueId` is the job's id, assigned here and echoed back so the extension
# can target cancel/reorder at a specific item.
STATE_LOCK = threading.Lock()
next_job_id = 1
active_job = None
wait_queue = []
current_proc = None
lock_proc = None
cancel_flag = False

# Probe coalescing: concurrent probes of the same URL share one yt-dlp run
# (`probe_waiters`), and results are cached briefly so a re-probe of the same
# URL right after (popup reopen churn, queue/auto-detection) isn't a fresh
# network round-trip. The cache is bounded and TTL-bounded; failures are
# cached too, so a dead URL isn't re-probed on every popup open.
PROBE_CACHE_TTL = 60.0
PROBE_CACHE_MAX = 8
PROBE_LOCK = threading.Lock()
probe_waiters = {}
probe_cache = {}

# read_theme() runs in the single dispatch thread, so these TTL caches need no
# locking. hyprctl (~8ms spawn) and fc-match (~15ms spawn) are re-invoked on
# every popup/options `theme` action past the SW's ~4s cache; the values are
# near-invariant at runtime, so cache them long enough to make theme requests
# pure file reads. Both TTLs are capped at a minute so a live `omarchy theme
# set` (new radius/font) propagates within ~60s instead of lingering, and a
# failed probe is forgotten just as quickly.
THEME_HYPR_TTL = 60.0
THEME_FONT_TTL = 60.0
_theme_hypr = {"t": 0.0, "v": None}
_theme_font = {"t": 0.0, "v": None}


def sanitize_selection(sel):
    """Echo-safe copy of a download selection.

    Every field is validated with the same whitelists build_command() uses, so
    the copy carried in queue snapshots (and used to re-run a download after a
    browser restart) can never smuggle anything into a later build_command()
    call or a popup render.
    """
    if not isinstance(sel, dict):
        return {}
    out = {"audioOnly": sel.get("audioOnly") is True,
           "playlist": sel.get("playlist") is True}
    title = clean(sel.get("title"), 200)
    if title:
        out["title"] = title
    label = sel.get("label")
    if isinstance(label, str) and RE_LABEL.fullmatch(label):
        out["label"] = label
    fmt = sel.get("formatId")
    if isinstance(fmt, str) and RE_FMTID.fullmatch(fmt):
        out["formatId"] = fmt
        out["formatHasAudio"] = sel.get("formatHasAudio") is True
        ext = sel.get("formatExt")
        # Same gate build_command() applies: only real merge containers are ever
        # used, so a snapshot can't carry an extension that a re-run would drop.
        if isinstance(ext, str) and len(ext) <= 16:
            ext = ext.lower()
            if ext in MERGE_CONTAINERS and ext != "best":
                out["formatExt"] = ext
    res = sel.get("resolution")
    if isinstance(res, str) and (res == "best" or RE_INT.fullmatch(res)):
        out["resolution"] = res
    container = sel.get("container")
    if container in MERGE_CONTAINERS:
        out["container"] = container
    afmt = sel.get("audioFmt")
    if afmt in ("best", "m4a", "mp3", "opus"):
        out["audioFmt"] = afmt
    chapters = sel.get("chapters")
    if chapters in ("off", "embed", "split"):
        out["chapters"] = chapters
    subs = sel.get("subs")
    if isinstance(subs, dict):
        s = {}
        if subs.get("on") is True:
            s["on"] = True
        if subs.get("auto") is True:
            s["auto"] = True
        if subs.get("embed") is True:
            s["embed"] = True
        convert = subs.get("convert")
        if convert in ("srt", "vtt", "best"):
            s["convert"] = convert
        langs = subs.get("langs")
        if isinstance(langs, str) and (langs == "all" or RE_LANG.fullmatch(langs)):
            s["langs"] = langs
        subfmt = subs.get("subFormat")
        if isinstance(subfmt, str) and RE_LANG.fullmatch(subfmt) and len(subfmt) <= 12:
            s["subFormat"] = subfmt
        if s:
            out["subs"] = s
    outdir = clean(sel.get("outputDir"), 2000)
    if outdir:
        out["outputDir"] = outdir
    return out


def queue_snapshot():
    """Active + waiting jobs (oldest-waiting last) for the `queue` event."""
    with STATE_LOCK:
        items = []
        if active_job is not None:
            items.append({
                "id": active_job["id"],
                "url": active_job["url"],
                "status": "paused" if active_job.get("paused") else "downloading",
                "position": 1,
                "selection": active_job["selection"],
            })
        for i, j in enumerate(wait_queue, start=2):
            items.append({
                "id": j["id"],
                "url": j["url"],
                "status": "queued",
                "position": i,
                "selection": j["selection"],
            })
        return items


def send_queue():
    send({"event": "queue", "queue": queue_snapshot()})


def start_worker(job):
    inflight_inc()
    threading.Thread(target=download_worker, args=(job,), daemon=True).start()


def finish_job(job=None):
    """The active job ended (done/error/cancelled): clear it and promote the
    next waiting job, then push the new queue. Success, failure, and cancel
    all advance the queue so one bad item never stalls the rest. `cancel_flag`
    is reset for the promoted job so a cancel aimed at the old job can't leak
    into the new one.

    Idempotent per job: `download_worker`'s wrapper calls it unconditionally
    (guaranteeing the queue advances even if the worker dies on an unexpected
    exception), so passing `job` makes a second call a no-op once that job is
    no longer active — the promotion below must only ever happen once.
    """
    global active_job, cancel_flag
    with STATE_LOCK:
        if job is not None and active_job is not job:
            return
        if active_job is not None:
            # A paused job's flag must not survive into the next job: scrub it
            # here (all terminal paths — done/error/cancel — funnel through
            # finish_job) so a paused cancel → promote next starts unpaused.
            active_job["paused"] = False
        active_job = None
        if wait_queue:
            active_job = wait_queue.pop(0)
            cancel_flag = False
            start_worker(active_job)
    send_queue()


def read_frame(stream):
    raw = stream.read(4)
    if not raw or len(raw) < 4:
        return None
    (n,) = struct.unpack("<I", raw)
    if n <= 0 or n > MAX_FRAME:
        return None
    data = stream.read(n)
    if len(data) != n:
        return None
    try:
        return json.loads(data.decode("utf-8"))
    except (ValueError, UnicodeDecodeError):
        return None


def http_url(url):
    if not isinstance(url, str) or not url or len(url) > MAX_URL:
        return None
    u = url.strip()
    try:
        parsed = urlparse(u)
    except ValueError:
        return None
    if parsed.scheme not in ("http", "https") or not parsed.netloc:
        return None
    return u


def clean(s, limit=2000):
    if not isinstance(s, str):
        return None
    s = RE_ANSI.sub("", s).strip()
    s = RE_CTRL.sub("", s)
    if not s or len(s) > limit:
        return None
    return s


def _read_utf8(path):
    try:
        with open(path, "r", encoding="utf-8") as fh:
            return fh.read()
    except OSError:
        return ""


def _parse_colors(text):
    """colors.toml: top-level `key = "#hex"` (quote optional), shell-style."""
    out = {}
    for line in text.splitlines():
        m = re.match(r'^\s*([A-Za-z0-9_-]+)\s*=\s*["\']?(#[0-9A-Fa-f]{6})', line)
        if not m or not RE_TOML_KEY.match(m.group(1)):
            continue
        out[m.group(1)] = m.group(2).lower()
    return out


def _parse_toml_lite(text):
    """shell.toml: `[section]` + `key = value`, mirroring the shell's parseShell.

    Values are quoted strings, bare numbers/widths, or bare keywords; the
    flattened key is `section.key`. Everything echoed is whitelist-validated.
    """
    parsed = {}
    section = ""
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        sm = re.match(r"^\[([A-Za-z0-9_-]+)\]\s*(#.*)?$", line)
        if sm:
            section = sm.group(1)
            continue
        m = (re.match(r'^([A-Za-z0-9_-]+)\s*=\s*"([^"]+)"\s*(#.*)?$', line)
             or re.match(r"^([A-Za-z0-9_-]+)\s*=\s*'([^']+)'\s*(#.*)?$", line)
             or re.match(r"^([A-Za-z0-9_-]+)\s*=\s*(-?\d+(?:\.\d+)?(?:\s+-?\d+(?:\.\d+)?){0,3})\s*(#.*)?$", line)
             or re.match(r"^([A-Za-z0-9_-]+)\s*=\s*([A-Za-z][A-Za-z0-9_-]*)\s*(#.*)?$", line))
        if not m or not section:
            continue
        key, value = m.group(1), m.group(2)
        if not RE_TOML_KEY.match(key):
            continue
        if not value or len(value) > MAX_THEME_VALUE or not RE_TOML_SAFE.match(value):
            continue
        parsed[section + "." + key] = value
    return parsed


def _hyprctl_rounding():
    now = time.monotonic()
    if now - _theme_hypr["t"] <= THEME_HYPR_TTL:
        return _theme_hypr["v"]
    try:
        proc = subprocess.run(
            ["hyprctl", "-j", "getoption", "decoration:rounding"],
            capture_output=True, text=True, timeout=3)
    except (OSError, subprocess.TimeoutExpired):
        n = None
    else:
        n = None
        if proc.returncode == 0:
            try:
                n = int(json.loads(proc.stdout).get("int"))
            except (ValueError, TypeError):
                n = None
    _theme_hypr.update(t=now, v=n if n is not None and 0 <= n <= 64 else None)
    return _theme_hypr["v"]


def _fc_match_mono():
    now = time.monotonic()
    if now - _theme_font["t"] <= THEME_FONT_TTL:
        return _theme_font["v"]
    try:
        proc = subprocess.run(
            ["fc-match", "-f", "%{family[0]}", "monospace"],
            capture_output=True, text=True, timeout=3)
    except (OSError, subprocess.TimeoutExpired):
        name = ""
    else:
        name = proc.stdout.strip()
    name = name if name and RE_FONT_NAME.match(name) else None
    _theme_font.update(t=now, v=name)
    return _theme_font["v"]


def read_theme():
    """Return the live Omarchy theme as {name, radius, fontFamily, colors, shell}."""
    if not os.path.isdir(THEME_STATE_DIR):
        return None
    colors_text = _read_utf8(os.path.join(THEME_STATE_DIR, "colors.toml"))
    colors = _parse_colors(colors_text)
    if not colors:
        return None
    shell = _parse_toml_lite(_read_utf8(os.path.join(THEME_STATE_DIR, "shell.toml")))
    shell.update(_parse_toml_lite(_read_utf8(USER_SHELL_TOML)))
    theme = {
        "name": None,
        "mode": None,
        "radius": None,
        "fontFamily": None,
        "colors": colors,
        "shell": shell,
    }
    name = _read_utf8(os.path.join(os.path.dirname(THEME_STATE_DIR), "theme.name")).strip()
    if RE_THEME_NAME.match(name):
        theme["name"] = name
    mm = re.search(r'^\s*mode\s*=\s*"(dark|light)"', colors_text, re.M)
    if mm and RE_THEME_MODE.match(mm.group(1)):
        theme["mode"] = mm.group(1)
    radius = _hyprctl_rounding()
    if radius is not None:
        theme["radius"] = radius
    family = _fc_match_mono()
    if family:
        theme["fontFamily"] = family
    return theme


def run_probe(url):
    cmd = [YTDLP, "--no-warnings", "--quiet", "-J", "--no-playlist", "--", url]
    try:
        proc = subprocess.run(cmd, capture_output=True, timeout=PROBE_TIMEOUT_S)
    except subprocess.TimeoutExpired:
        return None, "yt-dlp probe timed out"
    if proc.returncode != 0:
        err = RE_CTRL.sub("", proc.stderr.decode("utf-8", "replace")).strip()
        return None, err or "yt-dlp probe failed"
    try:
        info = json.loads(proc.stdout.decode("utf-8"))
    except ValueError:
        return None, "yt-dlp returned invalid JSON"
    return info, None


def flat_entries(url):
    cmd = [YTDLP, "--no-warnings", "--quiet", "-J", "--flat-playlist",
           "--playlist-items", "5", "--", url]
    try:
        proc = subprocess.run(cmd, capture_output=True, timeout=PROBE_TIMEOUT_S)
    except subprocess.TimeoutExpired:
        return []
    if proc.returncode != 0:
        return []
    try:
        info = json.loads(proc.stdout.decode("utf-8"))
    except ValueError:
        return []
    return [e for e in (info.get("entries") or []) if isinstance(e, dict)]


def filter_formats(info, duration=None):
    if not duration:
        duration = info.get("duration")
    fmt = []
    for f in info.get("formats") or []:
        fid = str(f.get("format_id") or "")
        vcodec = str(f.get("vcodec") or "none")
        acodec = str(f.get("acodec") or "none")
        note = str(f.get("format_note") or "")
        if vcodec == "none" and acodec == "none":
            continue
        if f.get("has_drm"):
            continue
        if re.search(r"storyboard|live.?chat", fid) or note.lower() in (
            "storyboard", "live chat"):
            continue
        height = f.get("height")
        width = f.get("width")
        size = f.get("filesize") or f.get("filesize_approx")
        if not (isinstance(size, (int, float)) and size > 0):
            bitrate = f.get("tbr") or f.get("vbr") or f.get("abr")
            if isinstance(bitrate, (int, float)) and bitrate > 0 and duration and duration > 0:
                size = int(bitrate * 1000 / 8 * duration)
        fmt.append({
            "id": clean(fid, 64) or "?",
            "note": clean(note, 64) or "",
            "height": height if isinstance(height, int) and height > 0 else None,
            "width": width if isinstance(width, int) and width > 0 else None,
            "fps": f.get("fps") if isinstance(f.get("fps"), (int, float)) else None,
            "ext": clean(f.get("ext"), 16) or "",
            "vcodec": clean(vcodec, 32) or "",
            "acodec": clean(acodec, 32) or "",
            "size": size if isinstance(size, (int, float)) and size > 0 else None,
        })
    return fmt


def sub_formats(tables):
    seen = []
    for table in tables:
        for entries in (table or {}).values():
            for e in entries:
                if isinstance(e, dict):
                    ext = str(e.get("ext") or "").strip().lower()
                    if ext and ext not in seen:
                        seen.append(ext)
    return seen


def probe_info(url):
    info, err = run_probe(url)
    if info is None and is_playlist_url(url):
        time.sleep(2)
        info, err = run_probe(url)
    if info is None:
        return None, err

    def langs(table):
        out = {}
        for code, entries in (table or {}).items():
            # e.get("ext") can be None on malformed track entries; sorted({None})
            # would raise TypeError and take down the whole host (this runs on
            # a request path), so keep only real non-empty strings.
            exts = sorted({e["ext"] for e in entries
                           if isinstance(e, dict) and isinstance(e.get("ext"), str) and e["ext"]})
            if exts:
                out[code] = exts
        return out

    count = info.get("playlist_count")

    def chapter_count(d):
        ch = d.get("chapters")
        if isinstance(ch, list) and ch and all(isinstance(c, dict) for c in ch):
            return len(ch)
        return None

    is_playlist = (bool(info.get("playlist_id")) or bool(count)
                   or is_playlist_url(url))
    meta = {
        "title": clean(info.get("title"), 500),
        "thumbnail": clean(info.get("thumbnail"), 2000),
        "duration": info.get("duration")
        if isinstance(info.get("duration"), (int, float)) else None,
        "extractor": clean(info.get("extractor"), 64),
        "webpage": clean(info.get("webpage_url"), 2000),
        "is_playlist": is_playlist,
        "playlist_count": count if isinstance(count, int) else None,
        "chapterCount": chapter_count(info),
    }

    formats, subs, auto_subs, sub_formats_list = [], {}, {}, []
    if is_playlist:
        first = None
        for e in flat_entries(url):
            if e.get("url") or e.get("id"):
                first = e
                break
        if first:
            target = first.get("url")
            if not target and first.get("id"):
                target = "https://www.youtube.com/watch?v=" + str(first["id"])
            target = http_url(target)
            first_info, first_err = run_probe(target) if target else (None, "no target")
            if first_info:
                formats = filter_formats(first_info, first_info.get("duration"))
                subs = langs(first_info.get("subtitles"))
                auto_subs = langs(first_info.get("automatic_captions"))
                sub_formats_list = sub_formats(
                    (first_info.get("subtitles"), first_info.get("automatic_captions")))
                meta["sample"] = clean(first.get("title") or first.get("id") or first_err, 160)
                first_ch = first_info.get("chapters")
                if isinstance(first_ch, list) and first_ch:
                    meta["chapterCount"] = chapter_count(first_info)
            else:
                meta["sample_error"] = True
    else:
        formats = filter_formats(info, info.get("duration"))
        subs = langs(info.get("subtitles"))
        auto_subs = langs(info.get("automatic_captions"))
        sub_formats_list = sub_formats(
            (info.get("subtitles"), info.get("automatic_captions")))

    return {
        "meta": meta,
        "formats": formats,
        "subs": subs,
        "autoSubs": auto_subs,
        "subFormats": sub_formats_list,
    }, None


def _reply_probe(req, payload, err):
    if payload is None:
        send({"req": req, "ok": False, "error": err or "probe failed"})
    else:
        send({"req": req, "ok": True, **payload})
    # One reply per probe req; drop the owner so REQ_OWNERS can't grow with a
    # long-lived client's probe history.
    forget_req(req)


def probe_worker(req, url):
    """Probe a URL off the main loop, coalescing concurrent same-URL probes.

    A pathological probe can block for minutes (two run_probe subprocess
    timeouts + flat_entries + the first-video probe); keeping it off the
    request loop means a slow probe never freezes cancel/queue/reorder
    handling. Download workers already run on their own threads, so only the
    probe was serializing the loop before.

    A burst of probes for the same URL (popup reopen churn) shares one run:
    the first caller starts it, later callers park in `probe_waiters` and get
    the same fan-out result. Results land in a short TTL-bounded cache so the
    popup's auto-reprobe / re-submit codepaths don't trigger a fresh network
    round-trip within a minute.

    `inflight_inc()` is paired with every exit path (cache hit, waiters-park,
    and the real run via the wrapper's finally) so the agent's idle watchdog
    never kills a still-running probe.
    """
    try:
        _probe_worker(req, url)
    finally:
        inflight_dec()


def _probe_worker(req, url):
    now = time.monotonic()
    with PROBE_LOCK:
        hit = probe_cache.get(url)
        if hit and now - hit[0] <= PROBE_CACHE_TTL:
            payload, err = hit[1]
            _reply_probe(req, payload, err)
            return
        waiting = probe_waiters.get(url)
        if waiting is not None:
            waiting.append(req)
            return
        probe_waiters[url] = [req]

    payload = err = None
    try:
        result, err = probe_info(url)
        if result is not None:
            payload = result
    except Exception:
        payload, err = None, "probe failed"
    finally:
        with PROBE_LOCK:
            waiters = probe_waiters.pop(url, [])
            if payload is not None or err:
                probe_cache[url] = (time.monotonic(), (payload, err))
                if len(probe_cache) > PROBE_CACHE_MAX:
                    # Drop expired entries first; if still over the bound, keep
                    # the newest PROBE_CACHE_MAX by insertion timestamp.
                    cutoff = time.monotonic() - PROBE_CACHE_TTL
                    for u in [u for u, (t, _) in probe_cache.items() if t < cutoff]:
                        probe_cache.pop(u, None)
                    while len(probe_cache) > PROBE_CACHE_MAX:
                        oldest = min(probe_cache, key=lambda u: probe_cache[u][0])
                        probe_cache.pop(oldest)
        for waiter in waiters:
            _reply_probe(waiter, payload, err)


